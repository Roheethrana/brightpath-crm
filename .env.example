# ==============================================================================
# BrightPath CRM — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename it to `.env` in the project root.
# 2. Retrieve your Project URL and Anon Key from your Supabase Dashboard:
#    Project Settings -> API -> Project URL & Project API Keys (anon / public)
# 3. DO NOT paste service_role keys or database passwords here.
#    Vite prefixes (VITE_*) are bundled into browser client code.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-client-key
